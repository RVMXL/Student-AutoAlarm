<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Сеть: API расписания kabinet.kgeu.ru -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- КРИТИЧНО для постановки будильника: без этого разрешения стоковые часы
         (AOSP/ColorOS/MIUI) МОЛЧА игнорируют ACTION_SET_ALARM — главная причина
         «будильники не ставятся вообще» на Realme/Oppo/Xiaomi -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Перезапуск ночных задач после перезагрузки -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Уведомления «будильник поставлен» (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Точные будильники: ночная сверка 00:05 + страховка 06:00.
         API 31–32: SCHEDULE_EXACT_ALARM выдан по умолчанию (отзываем пользователем);
         API 33+: USE_EXACT_ALARM — нормальное разрешение для приложений-будильников,
         выдаётся автоматически — проверщик просыпается каждый день без лишних настроек.
         setAlarmClock'у собственного звонка разрешение не требуется вовсе. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Кнопка «отключить оптимизацию батареи» в настройках -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- FGS-fallback expedited-работ WorkManager на Android 9–11 (dataSync) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Тип dataSync обязателен с API 34 (на старых API игнорируется) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Звонок собственного будильника (движок «В приложении»): вибрация, полноэкранный
         intent и тип mediaPlayback (обязателен с API 34) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Android 11+ (package visibility): видимость стоковых часов для ACTION_SET_ALARM.
         Intent-запись покрывает часы с декларированным intent-filter; явные <package>
         обязательны для оболочек, где часы НЕ декларируют SET_ALARM (ColorOS/Realme UI,
         часть MIUI) — без них getPackageInfo() рапортует «не установлено», и явный
         таргетинг пакета невозможен. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <!-- Oppo / OnePlus / Realme (ColorOS, OxygenOS, Realme UI) -->
        <package android:name="com.oplus.alarmclock" />
        <package android:name="com.coloros.alarmclock" />
        <!-- Samsung (One UI) -->
        <package android:name="com.sec.android.app.clockpackage" />
        <!-- Google Pixel / Motorola / стоковый AOSP -->
        <package android:name="com.google.android.deskclock" />
        <!-- Xiaomi / Redmi / Poco (MIUI, HyperOS), Huawei/Honor, Vivo — стандартное имя -->
        <package android:name="com.android.deskclock" />
        <package android:name="com.huawei.deskclock" />
        <!-- Tecno / Infinix / Itel (Transsion) -->
        <package android:name="com.transsion.deskclock" />
    </queries>

    <application
        android:name=".AutoAlarmApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UniAutoAlarm">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- После перезагрузки: восстановить ночной планировщик -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Точный ночной будильник планировщика (00:05) -->
        <receiver
            android:name=".alarm.NightlyAlarmReceiver"
            android:exported="false" />

        <!-- Ежедневное напоминание о будильнике (время из настроек; фолбэк для Realme/Huawei) -->
        <receiver
            android:name=".alarm.ReminderReceiver"
            android:exported="false" />

        <!-- Срабатывание собственного будильника (движок «В приложении») -->
        <receiver
            android:name=".alarm.AlarmFireReceiver"
            android:exported="false" />

        <!-- Звонок собственного будильника: звук + вибрация (foreground mediaPlayback) -->
        <service
            android:name=".alarm.AlarmRingingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Полноэкранный звонок собственного будильника (поверх экрана блокировки) -->
        <activity
            android:name=".ui.ring.RingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!--
            WorkManager: expedited-работы на Android < 12 исполняются как foreground-сервис.
            Указываем тип dataSync для SystemForegroundService (требование lint
            SpecifyForegroundServiceType); на Android 12+ работает обычный expedited Job.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
