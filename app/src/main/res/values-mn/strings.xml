    <string name="set_offset_example">Анхны хичээл 08:30-д → сэрүүлэг %1$s</string>
    <string name="set_per_pair">Хичээл бүрт босох</string>
    <string name="set_per_pair_desc">Өдөр бүрийн анхны хичээлд бэлдэх өөрийн хугацаа: эрт хичээлийн өмнө бага, оройн өмнө их — өглөөний хоолоо идэхэд. Өөрийн утгагүй хичээлүүд дээрх нийт босолтыг ашиглана.</string>
    <string name="set_pairs_after_sync">Хичээлийн цагууд хуваарийн синхрончлалын дараа гарна</string>
    <string name="pair_at">Хичээл %1$s</string>
    <string name="pair_custom_offset">%1$s өмнө босох → сэрүүлэг %2$s</string>
