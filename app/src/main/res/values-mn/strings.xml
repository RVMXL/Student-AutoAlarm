    <string name="alarm_target_app">Аппад</string>
    <string name="set_show_clock">Тавихдаа цагийг харуулах</string>
    <string name="set_show_clock_desc">Сэрүүлэг өөрөө тавигдахгүй бол асаана уу (Realme, Oppo, Huawei). Шөнийн шалгалт, туршилтын сэрүүлэг бэлэн сэрүүлэгтэй цагийг нээнэ — «Хадгалах» товчоор баталгаажуул. Үндсэн сэлгүүр, хөдөлгүүр солилт цагийг нээлгүй чимээгүй тавина.</string>
