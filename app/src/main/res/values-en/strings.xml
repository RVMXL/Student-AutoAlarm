    <string name="status_exact_allowed">Exact alarms are allowed</string>
    <string name="dialog_exact_off_title">Exact alarms are disabled by the system</string>
    <string name="dialog_exact_off_desc">The overnight scheduler will only be able to set the alarm with a ±10 minute deviation.</string>
    <string name="dialog_battery2_title">Battery optimization may interfere</string>
    <string name="dialog_battery2_desc">Exclude the app from battery optimization so the overnight schedule re-check doesn\'t fail.</string>
    <string name="action_disable_optimization">Disable optimization</string>
    <string name="autostart_title">Autostart and aggressive system shells</string>
    <string name="autostart_desc">MIUI, HarmonyOS and other shells kill background apps</string>
    <string name="btn_instructions">Instructions</string>
    <string name="autostart_xiaomi">Xiaomi / Redmi / POCO:\nSecurity → Apps → Autostart: enable Auto-Alarm; in the app\'s battery settings choose \"No restrictions\".</string>
    <string name="autostart_huawei">Huawei / Honor:\nSettings → Battery → App launch → Auto-Alarm → Manage manually: turn on all the toggles.</string>
    <string name="autostart_oppo">OPPO / Realme / OnePlus:\nSettings → Battery → More settings → Power consumption optimization → turn off optimization for the app; App manager → Autostart.</string>
    <string name="autostart_samsung">Samsung:\nSettings → Battery → Background usage limits → Never sleeping apps → add Auto-Alarm.</string>
    <string name="autostart_other">Other shell:\nAdd the app to autostart and remove its battery optimizations in the system settings.</string>
    <string name="autostart_standard_note">Standard mode reschedules the alarm every night — the app needs to run in the background at 00:05.</string>

