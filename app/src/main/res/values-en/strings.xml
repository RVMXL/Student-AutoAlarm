    <!-- ==== Settings: alarm ==== -->
    <string name="set_auto_title">Auto-Alarm</string>
    <string name="alarm_target_title">Where the alarm rings</string>
    <string name="alarm_target_desc">«Clock app» — the familiar signal in the phone\'s clock (system shells may block commands). «In the app» — the app rings full-screen itself: the toggle, dismissing and schedule changes are guaranteed to work.</string>
    <string name="alarm_target_clock">Clock app</string>
    <string name="alarm_target_app">In the app</string>
    <string name="set_show_clock">Show the Clock app when setting alarms</string>
    <string name="set_show_clock_desc">Turn on if alarms aren\'t set on their own (Realme, Oppo, Huawei): the Clock app will open with the alarm ready — confirm it with \"Save\".</string>
    <string name="set_wake_offset">Wake up %1$s before your first class</string>
    <string name="set_offset_example">First class at 08:30 → alarm at %1$s</string>
    <string name="set_per_pair">Wake-up for each class</string>
    <string name="set_per_pair_desc">Your own getting-ready time for each day\'s first class: a bit less before early ones, a bit more before later ones, so you have time for breakfast. Classes without their own value use the common wake-up offset above.</string>
    <string name="set_pairs_after_sync">Class times will appear after you sync the schedule</string>
    <string name="pair_at">Class at %1$s</string>
    <string name="pair_custom_offset">Wake-up %1$s before → alarm at %2$s</string>
    <string name="pair_common_offset">Common wake-up: %1$s before</string>
    <string name="btn_disable_app_alarms">Turn off the app\'s alarms</string>
    <string name="disable_alarms_desc">The button sends a dismiss command to the Clock app using the exact labels \"Авто: Пн\"…\"Авто: Вс\". If the system shell doesn\'t accept the command (some Realme UI/ColorOS versions — a system limitation), the app will open the alarm list itself — remove the \"Авто:\" alarms manually.</string>
    <string name="btn_test_alarm">Test the alarm</string>
    <string name="btn_alarm_list">Alarm list</string>
    <string name="alarms_list_open_failed">The Clock app didn\'t open the alarm list</string>
    <string name="dismiss_alarms_sent">Dismiss command sent to the Clock app (%1$d of %2$d). If any \"Авто: …\" alarms are left, turn them off in the alarm list</string>
    <string name="dismiss_unsupported_opened">The Clock app doesn\'t support dismiss commands (system shell limitation) — the alarm list is open: turn off the \"Авто:\" alarms manually</string>
    <string name="dismiss_unsupported_manual">The Clock app doesn\'t support dismiss commands (system shell limitation) — open the alarms in the Clock app and remove the \"Авто:\" labels manually</string>

