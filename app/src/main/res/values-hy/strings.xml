    <!-- ==== Կարգավորումներ. զարթուցիչ ==== -->
    <string name="set_auto_title">Ավտոզարթուցիչ</string>
    <string name="alarm_target_title">Որտեղ է զնգում զարթուցիչը</string>
    <string name="alarm_target_desc">«Ժամացույցում» — սովորական ազդանշան հեռախոսի ժամացույցում (ինտերֆեյսները կարող են արգելափակել հրամանները): «Հավելվածում» — հավելվածն ինքն է զնգում ամբողջ էկրանով. անջատիչը, անջատումը և դասացուցակի փոփոխություններն աշխատում են երաշխավորված:</string>
    <string name="alarm_target_clock">Ժամացույցում</string>
    <string name="alarm_target_app">Հավելվածում</string>
    <string name="set_show_clock">Ցույց տալ ժամացույցը դնելիս</string>
    <string name="set_show_clock_desc">Միացրեք, եթե զարթուցիչներն ինքնուրույն չեն դրվում (Realme, Oppo, Huawei). Գիշերային ստուգումը և թեստային զարթուցիչը կբացեն ժամացույցը պատրաստի զարթուցիչով — հաստատեք «Պահպանել» կոճակով: Հիմնական անջատիչը և շարժիչի փոփոխությունը դնում են լուռ, առանց ժամացույցը բացելու:</string>
    <string name="set_wake_offset">Արթնանալ առաջին դասից %1$s առաջ</string>
    <string name="set_offset_example">Առաջին դասը 08:30-ին → զարթուցիչը՝ %1$s</string>
    <string name="set_per_pair">Արթնացում յուրաքանչյուր դասի համար</string>
    <string name="set_per_pair_desc">Սեփական պատրաստվելու ժամանակ յուրաքանչյուր օրվա առաջին դասի համար. վաղ դասից առաջ՝ պակաս, ուշից առաջ՝ ավելի շատ, որ հասցնեք նախաճաշել: Առանց սեփական արժեքի դասերը օգտագործում են վերևի ընդհանուր արթնացումը:</string>
    <string name="set_pairs_after_sync">Դասերի ժամերը կհայտնվեն դասացուցակի համաժամեցումից հետո</string>
